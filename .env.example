## Expo public env (safe to expose to client)
## Create a file named `.env.local` with these values filled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

## Stripe public price IDs (safe to ship in client)
EXPO_PUBLIC_STRIPE_PRICE_MONTHLY=
EXPO_PUBLIC_STRIPE_PRICE_YEARLY=

## Production (Render) — example
# EXPO_PUBLIC_API_BASE_URL=https://addx.onrender.com/api
# EXPO_PUBLIC_AUTH_BRIDGE_URL=https://addx.onrender.com

## Local dev — this PC’s IPv4 (same Wi‑Fi as phone) or Android emulator http://10.0.2.2:PORT/api
EXPO_PUBLIC_API_BASE_URL=

## Same host as backend, NO /api — magic link opens https://…/auth/open then native app
EXPO_PUBLIC_AUTH_BRIDGE_URL=

## Set to 1 to print tap + API logs when not in __DEV__ (release builds)
EXPO_PUBLIC_APP_LOGS=

## Backend-only secrets (DO NOT put these in client env)
## addx/backend/.env:
## - SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (for TTS upload)
## - OPENAI_API_KEY
## - LLM_GATEWAY_URL (web_llm_api_backend), e.g. https://llm-backend-635x.onrender.com (set on Render for addx backend, NOT in Expo)
## - JAMENDO_CLIENT_ID
## - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET

