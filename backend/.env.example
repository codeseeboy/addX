PORT=4000

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for TTS MP3 upload from Node (never put in Expo env).
SUPABASE_SERVICE_ROLE_KEY=

# Optional override; must match storage bucket id after running supabase/storage_ad_audio.sql
SUPABASE_AD_AUDIO_BUCKET=ad-audio

# After magic link, /auth/open redirects the browser to this app URL (same ?query #hash).
# Expo Go: use exp://YOUR_LAN_IP:8081/--/auth/callback  (see Metro). Dev build: addx://auth/callback
AUTH_DEEP_LINK=addx://auth/callback

# Multi-LLM gateway (run: cd web_llm_api_backend && python run.py)
LLM_GATEWAY_URL=http://127.0.0.1:8000
LLM_GATEWAY_PREFERRED_PROVIDER=groq

# Jamendo developer client id — https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# OpenAI: used for script path elsewhere if configured. TTS: if key + quota OK, used first; on failure or set TTS_ENGINE=edge, uses free Edge voices (no key).
OPENAI_API_KEY=

# Optional: force free Microsoft Edge TTS only (no OpenAI TTS). Values: edge | google-only | (empty = OpenAI first when OPENAI_API_KEY set, else Edge, then Google Translate unofficial fallback).
# TTS_ENGINE=edge
# TTS_ENGINE=google-only

# When OpenAI + Edge fail, try unofficial Google Translate TTS (MIT package). Set 0 to disable in strict/prod environments.
# TTS_GOOGLE_FALLBACK=1
# Optional mirror if translate.google.com is blocked: GOOGLE_TTS_HOST=https://translate.google.com.cn

STRIPE_SECRET_KEY=

